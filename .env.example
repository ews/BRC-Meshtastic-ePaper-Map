# Copy this file to .env and keep the real values private.
# The Meshtastic channel URL contains the channel encryption keys.
MESHTASTIC_CHANNEL_URL=

# Burning Mesh radios commonly use this fixed BLE PIN.
MESHTASTIC_BLE_PIN=123456

# Comma-separated BLE address=expected node ID entries. Apply mode refuses
# entries without an expected node ID and skips any identity mismatch.
# Discover addresses first with: make mesh-ble-scan
MESHTASTIC_BLE_TARGETS=AA:BB:CC:DD:EE:FF=!12345678
